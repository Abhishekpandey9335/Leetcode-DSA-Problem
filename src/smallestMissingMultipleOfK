class Solution {
    public int missingMultiple(int[] nums, int k) {
        Set <Integer>set = new HashSet<>();
        int len = nums.length;
        //Add all element
        for(int i = 0;i<len;i++){
            set.add(nums[i]);

        }
        //checking multiple of k
        int val =1;
        while(set.contains(val*k)){
            val++;
        }
        //return the first missing multiple
        return val * k;
    }
}