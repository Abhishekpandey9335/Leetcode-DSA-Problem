class Solution {
    public int numWaterBottles(int numBottles, int numExchange) {
       int drank = numBottles;
       while(numBottles >= numExchange){
        int exchanged = numBottles/numExchange;
        int extraEmpty = numBottles%numExchange;
        drank+=exchanged;
        numBottles = exchanged + extraEmpty;

       }
       return drank;
    }
}class Solution {
     public int maxBottlesDrunk(int numBottles, int numExchange) {
         int result = numBottles;//for Drink
         int emptyWB = numBottles;
         while(emptyWB >= numExchange){
             emptyWB = emptyWB - numExchange;
             numExchange+=1;
             result+=1;
             emptyWB+=1;
         }
         return result;



     }
 }